/**
 * 协议层 DTO Schema (TypeScript Schema Format)
 * =====================================================================
 * 文件: 协议层DTO Schema.tsd
 * Transport 版本: MESSAGE_PROTOCOL_VERSION = '1.0.0'
 * 源码同步日期: 2026-10-15（历史概念模型初稿 2026-07-24）
 * 范围: 当前源码契约索引 + 历史业务概念模型；本 .tsd 不参与编译或运行时校验
 *
 * 历史业务概念模型的设计目标（不是当前 transport 已实现的统一校验）:
 * 1. 所有 DTO 强约束 WGS84 坐标系 (经度, 纬度) 顺序，渲染层前由底座插件转换
 * 2. 所有 ID 必填，加业务前缀 (alarm_/call_/route_/plan_/vehicle_/trail_)
 * 3. 协议层只承载"业务控制层输出 ↔ 通用控制层输入"的契约
 * 4. 状态机迁移严格遵循 08-业务状态机定义.md 的有向边
 * 5. 历史概念版本号 v1.0；当前 transport 使用 v 字段，见下方“当前契约”
 *
 * 文件命名规范: *.tsd (TypeScript Schema Definition)
 * 本文不证明存在 zod/valibot 或 CI 100% schema 一致性检查；以 package.json / 源码为准
 * =====================================================================
 */

// =====================================================================
// A. 当前契约（源码为准；不新增事件，不代表最终核验或人工验收完成）
// =====================================================================

/**
 * 实际信封：src/types/message.ts。
 * 字段：id: string、timestamp: number、channel、system、eventKey、data: T；
 * 可选：targetSystem、meta: MessageMetadata、v: '1.0.0'、isRemoveSameElement。
 * 没有统一 eventId/occurredAt/payload/version/scene/source/coordSys/tenantId 字段。
 * meta.eventId/meta.source 是源消息追踪信息，不替代信封 id/system。
 * store 创建信封时写入 v；标准 Envelope 快路要求 v === '1.0.0'。
 * 此处以 unknown 实例化未指定的示例载荷；完整泛型定义直接引用源文件。
 */
export type MessageEnvelope<T = unknown> = import('../../src/types/message').MessageEnvelope<T>;
export type { MessageMetadata } from '../../src/types/message';
export type {
  MessageChannel, MessageSystem, MessageEventKey,
} from '../../src/const/const.message.type';

/**
 * MESSAGE_CHANNEL 实际值：ws | postMessage | broadcastChannel | localStorage | http。
 * MESSAGE_SYSTEM 实际值：host | map | three | dispatch | ids-seat-web。
 * 事件键唯一声明：src/const/const.message.type.ts；不从下文历史概念名推导新事件。
 * LOCAL_STORAGE：F10 bridge 构造业务信封后 ingest，不是总线自动扫描所有 storage。
 * HTTP：F13 画像补水入站后 ingest；useMessageStore.publish 对 HTTP 返回 false。
 * 标准 Envelope → interceptorRegistry → Legacy eventKey/type 是公共 ingest 的顺序；
 * WS 回调共用 receive 但关闭最后 Legacy 回退，不扩大其原始 eventKey/type 支持范围。
 */

/**
 * tracking.vehicle.gps.update 的实际 data：
 * interface CarLocationPoint {
 *   carId: string;
 *   orgId?: string;
 *   orgName?: string;
 *   latitude: number;
 *   longitude: number;
 *   plateNumber: string;
 *   gpsTime?: string;
 * }
 * interface CarLocationBatch { datas: CarLocationPoint[]; }
 * TrackingVehicleGpsUpdateData 同样仅含 datas，无必填 incidentId/layerId。
 * 不使用历史 VehicleGPS.position 或单点 TrackingGpsUpdateData 包装实际 GPS。
 */
export type {
  CarLocationPoint, CarLocationBatch, AlarmIncidentStateData,
  AlarmCallAnswerStatusData, PositionPayload,
} from '../../src/controller/core/protocol/LegacyMessageProtocol';
export type {
  TrackingVehicleGpsUpdateData, TrackingVehicleRouteRealtimeData,
  AddressRobotGisSearchData, LocateCallData, LocateCallRemoveData,
} from '../../src/controller/core/protocol/BusinessProtocol';

/**
 * 行政区划围栏指令 DTO：
 * AreaFenceHighlightData 必含 areaCode 与 GeoJSON 几何（EPSG:4326 / WGS-84），
 * areaName/flash/strokeColor/strokeWidth 可选；flash=true 时渲染器先闪烁再落回常驻描边。
 * AreaFenceClearData 仅含可选 businessId（缺省清除全部行政区划围栏）。
 * 几何数据来源见 @/apis/envArea（GeoServer gis:env_area_fence 优先，DataV GeoAtlas 兜底）。
 */
export type {
  AreaFenceHighlightData, AreaFenceClearData,
} from '../../src/controller/core/protocol/BusinessProtocol';

/**
 * disaster_profile.address_updated 的实际 data：AddressUpdatedData。
 * 必含 version: number、slots: Record<string, string | null>，
 * address/longitude/latitude/primaryStationId 可空；
 * eventId/occurredAt/disasterProfileId/incidentId/inquiryId 为可选源标识。
 * 快照语义在 MessageMetadata.snapshotKind?: 'full' | 'delta'。
 * service/incidentLocation.ts 将 slots[] 推为 full、slotChanges[] 推为 delta；
 * 归一后的 slots 字典不能自行证明 full，入口须保留 meta.snapshotKind。
 * full 替换槽位，delta 合并；缺省槽位与显式 null/空坐标不同。
 * HTTP profile sync 强制 full，并携带 source='http-profile'、contextKey、
 * sessionEpoch、contextRevision、requestRevision 等水位信息；relay/WS 同样保留种类。
 */
export type {
  AddressUpdatedData, IncidentLocationSnapshotKind, IncidentLocationContext,
  IncidentLocationSharedState, IncidentProfileData, NormalizedIncidentLocation,
  IncidentLocationAcceptance, IncidentLocationRenderingPort, IncidentLocationReceiver,
} from '../../src/controller/core/protocol/IncidentLocationProtocol';

/**
 * IncidentLocationAcceptance 拒绝原因含 'terminal'：
 * 警情处于 5 个终态（ARRIVED / OPERATION_COMPLETED / RETURNED / CLOSED /
 * POST_ACTION_REVIEWED）时不再上图，由车辆历史轨迹链路接管，并 clearAll。
 */

/**
 * SharedState 源：core/protocol/SharedStateProtocol.ts。
 * v?/updatedAt?、auth?/user?/seat?、phase?、currentAlarm?、mode?；
 * auth/user/seat/currentAlarm 可空，auth 支持 Tenantid / X-Trace-Id。
 * MapPhase = loggedOut | onDuty | popup | inquiry | dispatch | dispatchTrack。
 * MapMode 是 useUserStore 对原始 phase 的保存，不是派生有效阶段。
 * utils/seatSharedState.ts::getSharedMapStage 校验 v=1、有限 updatedAt、auth，
 * inquiry + currentAlarm=null → inquiry；inquiry + 有效 incidentId → dispatch；
 * auth=null → loggedOut；裸 phase='dispatch' 不直接放行。
 * user store 保存 rawState/currentAlarm/mode、sharedStateRevision、lastSharedReceiveAt、
 * mockRevision/sessionEpoch；initUserStore 集中初始读取与 storage 监听。
 */
export type {
  MapPhase, SharedState, SharedUser, SharedAuth, SharedSeat,
  SharedCurrentAlarm, SharedMessageSession,
} from '../../src/controller/core/protocol/SharedStateProtocol';

/**
 * BusinessMapPort 是 controller → 地图底座边界，无 OL/Three 类型：
 * readonly ready: boolean；view/geometry/spatial/kinematic 使用 GenericProtocol DTO；
 * trackingVehicleGpsUpdate(data: TrackingVehicleGpsUpdateData): void；
 * addressRobotGisSearch(data: AddressRobotGisSearchData, options?: { businessId?: string }): void | Promise<void>；
 * addressRobotClear(options?: { businessId?: string }): void。
 * areaFenceHighlight(data: AreaFenceHighlightData, options?: { businessId?: string }): void；
 * areaFenceClear(data?: AreaFenceClearData): void。
 * MockMapPort：render/disasterSite/simulate/clear/dispatchVehicles。
 * BusinessMapAttachment：kind?: 'map' | 'dispatch'、mock?、dispose?。
 * baseComponent/OpenlayersMap/businessMapPort.ts::createBusinessMapPort(generic)
 * 返回 { port, dispose }，装配 AddressRobotRenderer 与 AreaFenceRenderer。
 */
export type {
  BusinessMapPort, BusinessMapAttachment, MockMapPort,
} from '../../src/controller/core/protocol/BusinessMapPort';

/**
 * 接线索引（方法/生命周期不是新 transport 事件）：
 * - core/io/BusinessMessageRuntime：start、attachMap、attachTracking、leaveDispatch、dispose。
 *   两个 attach 返回解绑函数；attachTracking 同步 hydrate 最新 accepted GPS。
 * - InputController + messageStagePolicy：应用级业务接收、500ms 稳定窗口与阶段门控。
 * - IncidentLocationController.receive(envelope)：委托 useIncidentLocationStore 做
 *   身份/版本/阶段/会话/HTTP 水位接受校验；store 保存 marker/槽位快照并派生资源。
 * - normalizeBusinessFrames 按 916 顺序：地址机器人→位置→GPS→接听→警情→画像地址，
 *   先整轮原生识别，无结果才整轮包装增强；install 与 SEAT 使用同一归一裁决。
 *   位置/GPS 可多结果并去重，answer/incident 仅首匹配；SEAT multi 不等于各类全扇出。
 * - T1(priority 900, fallback) 最后兜底，只接受根 eventType 或根 payload 单对象的
 *   eventType/eventKey，保留原值/data，不映射常量名，不展开列表/深层 T1 包装。
 * - F10 composables/useMockCallLocationBridge 解析/去重/LOCAL_STORAGE ingest，
 *   Runtime 按会话/generation 排队执行 MockMapPort，仅 dispatch attachment 执行。
 * - F11 composables/useMapRelayReader 承接 relay 并修正快照/上下文接入；
 *   F13 composables/useIncidentLocationProfileSync 修正首次补水与在途上下文竞争。
 * - 仅 F12 composables/useGisPointSelection 的现有 V1.0 选点/ACK 会话等价迁位，
 *   既有可靠性缺陷保持冻结；F11/F13 不属冻结项。PICK_* / relay kind 不新增内部事件键。
 * - composables/useBroadcastChannelBridge 仅 send/listen/close/dispose；
 *   hooks/useBroadcastChannel 的 BroadcastChannelClient 为总线提供通用 BC 传输。
 * - VehicleRenderer、AddressRobotRenderer、AddressRobotUtils、SwipeControl 位于
 *   baseComponent/OpenlayersMap；旧业务 vehicleManager 仅兼容导出。
 * - Control/**、useMessageStore916.ts 和 messageStageGate.ts 保留对照；
 *   完整人工验收后，须由用户另行确认清理，不能宣称旧 normalizer 全部无引用。
 */

// =====================================================================
// B. 历史业务概念模型（以下 0～13 节均非当前 transport 字段/事件声明）
// 保留用于理解业务目标；ID 前缀、状态机、焦点及校验 helper 不表示统一门禁已实现。
// 同名 DTO 与源码冲突时以 A 节指向的 src/** 类型为准，不将本文导入活动代码。
// =====================================================================

// =====================================================================
// 0. 基础类型 (Base Types)
// =====================================================================

/** 协议版本号（必须随字段升级而升 minor 版本） */
export type ProtocolVersion = '1.0';

/** WGS84 经度（-180 ~ 180） */
export type Longitude = number;

/** WGS84 纬度（-90 ~ 90） */
export type Latitude = number;

/** ISO 8601 时间戳 */
export type ISOTimestamp = string;

/** 业务 ID（必须含业务前缀，由 protectInvariants 校验） */
export type BusinessId = string;

/** 缩放级别（0~22） */
export type ZoomLevel = number;

/** 距离（单位米） */
export type Meters = number;

/** 角度（弧度） */
export type Radians = number;

/** 比例系数（0~1） */
export type Ratio = number;

// =====================================================================
// 1. 地理基础 (Geo Primitives)
// =====================================================================

/** WGS84 地理坐标点 */
export interface GeoPoint {
  /** 经度（-180 ~ 180） */
  lng: Longitude;
  /** 纬度（-90 ~ 90） */
  lat: Latitude;
}

/** WGS84 坐标点数组（用于路径、轨迹） */
export interface GeoPath {
  coordinates: GeoPoint[];
  /** 总距离（米） */
  distance: Meters;
  /** 总耗时（秒） */
  duration: number;
}

/** 矩形包围盒（用于视野自适应） */
export interface BoundingBox {
  southWest: GeoPoint;
  northEast: GeoPoint;
}

// =====================================================================
// 2. 统一消息信封 (Message Envelope)
// =====================================================================

/**
 * 历史业务概念信封；非当前 MessageEnvelope transport
 * messageId/messageType/payload/version 等字段仅保留为历史模型
 */
export interface HistoricalBusinessConceptEnvelope<T = unknown> {
  /** 消息全局唯一 ID（UUID v4） */
  messageId: string;
  /** 消息类型（例：AlarmChanged / VehicleChanged / DispatchChanged） */
  messageType: MessageType;
  /** 消息载荷（业务数据） */
  payload: T;
  /** 时间戳 */
  timestamp: ISOTimestamp;
  /** 消息来源（业务控制层标识） */
  source: ControlLayerSource;
  /** 协议版本 */
  version: ProtocolVersion;
  /** 业务追踪 ID（用于链路追踪） */
  traceId?: string;
}

/** 消息类型枚举 */
export type MessageType =
  // 业务控制层输出
  | 'AlarmChanged'
  | 'CallChanged'
  | 'InquiryChanged'
  | 'DispatchChanged'
  | 'DutyChanged'
  | 'TrackingChanged'
  // 通用控制层输入
  | 'GenericControlInput'
  // IO 控制层输出
  | 'InputEvent'
  | 'OutputEvent'
  // 状态机事件
  | 'StateMachineEvent'
  // 异常事件
  | 'ExceptionEvent';

/** 控制层来源标识 */
export type ControlLayerSource =
  | 'AlarmCtrl'
  | 'CallCtrl'
  | 'InquiryCtrl'
  | 'DispatchCtrl'
  | 'DutyCtrl'
  | 'TrackingCtrl'
  | 'GeometryCtrl'
  | 'KinematicCtrl'
  | 'SpatialCtrl'
  | 'ViewCtrl'
  | 'InputCtrl'
  | 'OutputCtrl';

// =====================================================================
// 3. 业务控制层输出 DTO (Business Ctrl Output)
// =====================================================================

/** 警情状态枚举 */
export type AlarmStatus =
  | 'CREATED'
  | 'INQUIRING'
  | 'DISPATCHED'
  | 'ON_SCENE_HANDLING'
  | 'RE_DISPATCH'
  | 'CLOSED';

/** 警情类型 */
export type AlarmType =
  | 'FIRE'           // 火灾
  | 'RESCUE'         // 救援
  | 'TRAFFIC'        // 车祸
  | 'HAZARD'         // 抢险
  | 'OTHER';         // 其他

/** 严重等级 1~5 */
export type SeverityLevel = 1 | 2 | 3 | 4 | 5;

/** 警情 DTO（业务控制层输出 / 通用控制层输入） */
export interface AlarmProfile {
  /** 警情 ID（必填，含 alarm_ 前缀） */
  alarmId: BusinessId;
  /** 警情位置（WGS84） */
  alarmLocation: GeoPoint;
  /** 警情类型 */
  alarmType: AlarmType;
  /** 严重等级 */
  severityLevel: SeverityLevel;
  /** 发生时间 */
  occurredAt: ISOTimestamp;
  /** 警情状态 */
  status: AlarmStatus;
  /** 关联来电 ID（可选） */
  callId?: BusinessId;
  /** 关联车辆 ID 列表（可选） */
  vehicleIds?: BusinessId[];
  /** 调派计划 ID（可选） */
  dispatchPlanId?: BusinessId;
}

/** 警情变更事件载荷 */
export interface AlarmChangedPayload {
  alarmId: BusinessId;
  /** 变更前的状态 */
  previousStatus?: AlarmStatus;
  /** 变更后的状态 */
  currentStatus: AlarmStatus;
  /** 警情完整数据 */
  alarm: AlarmProfile;
  /** 触发原因 */
  reason: string;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================

/** 来电 DTO */
export interface CallLocation {
  /** 来电 ID（必填，含 call_ 前缀） */
  callId: BusinessId;
  /** 主叫号码 */
  callerNumber: string;
  /** 来电位置（WGS84） */
  callLocation: GeoPoint;
  /** 弹屏时间 */
  arrivedAt: ISOTimestamp;
  /** 关联警情 ID（可选） */
  alarmId?: BusinessId;
  /** 问询信息 */
  payload?: InquiryPayload;
}

/** 问询信息 */
export interface InquiryPayload {
  /** 事发地址 */
  address: string;
  /** 灾情类型 */
  disasterType: AlarmType;
  /** 伤亡情况 */
  casualties?: string;
  /** 受困人数 */
  trappedPersons?: number;
  /** 补充信息 */
  extraInfo?: string;
}

/** 来电变更事件载荷 */
export interface CallChangedPayload {
  callId: BusinessId;
  /** 来电完整数据 */
  call: CallLocation;
  /** 触发原因 */
  reason: string;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================

/** 调派计划状态 */
export type DispatchStatus =
  | 'DRAFT'
  | 'READY'
  | 'DISPATCHED'
  | 'EXECUTING'
  | 'REVOKED'
  | 'COMPLETED';

/** 调派计划 DTO */
export interface DispatchPlan {
  /** 调派计划 ID（必填，含 plan_ 前缀） */
  planId: BusinessId;
  /** 关联警情 ID */
  alarmId: BusinessId;
  /** 调派车辆 ID 列表 */
  vehicleIds: BusinessId[];
  /** 调派状态 */
  status: DispatchStatus;
  /** 调派路径（可选） */
  route?: DispatchRoute;
  /** 围栏列表（可选） */
  fences?: Fence[];
  /** 创建时间 */
  createdAt: ISOTimestamp;
  /** 提交时间（可选） */
  submittedAt?: ISOTimestamp;
}

/** 调派路径 DTO */
export interface DispatchRoute {
  /** 调派计划 ID */
  planId: BusinessId;
  /** 路径坐标串（WGS84） */
  coordinates: GeoPoint[];
  /** 路径距离（米） */
  distance: Meters;
  /** 路径耗时（秒） */
  duration: number;
  /** 是否降级 */
  fallback: boolean;
}

/** 调派路径 ID 前缀为 route_ */
export type RouteId = BusinessId & { __prefix: 'route_' };

/** 调派变更事件载荷 */
export interface DispatchChangedPayload {
  planId: BusinessId;
  /** 变更前状态 */
  previousStatus?: DispatchStatus;
  /** 变更后状态 */
  currentStatus: DispatchStatus;
  /** 调派计划完整数据 */
  plan: DispatchPlan;
  /** 触发原因 */
  reason: string;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================

/** 车辆状态 */
export type VehicleStatus =
  | 'IN_GARAGE'        // 车库待命
  | 'EN_ROUTE'         // 出动中
  | 'ON_SCENE'         // 到场
  | 'TRANSFERRING'     // 转场中
  | 'HANDLING'         // 处置中
  | 'RETURNING'        // 返回中
  | 'UNAVAILABLE'      // 不可用
  | 'CLOSED';          // 已归档

/** 车辆 DTO */
export interface VehicleGPS {
  /** 车辆 ID（必填，含 vehicle_ 前缀） */
  vehicleId: BusinessId;
  /** 车牌号 */
  plateNumber: string;
  /** 当前位置（WGS84） */
  position: GeoPoint;
  /** 车辆状态 */
  status: VehicleStatus;
  /** 当前警情 ID（可选） */
  currentAlarmId?: BusinessId;
  /** 最后 GPS 时间 */
  lastGpsAt: ISOTimestamp;
  /** GPS 是否丢失 */
  gpsLost: boolean;
  /** 速度（米/秒，可选） */
  speed?: number;
  /** 航向角（弧度，可选） */
  heading?: Radians;
}

/** 车辆变更事件载荷 */
export interface VehicleChangedPayload {
  vehicleId: BusinessId;
  /** 变更前状态 */
  previousStatus?: VehicleStatus;
  /** 变更后状态 */
  currentStatus: VehicleStatus;
  /** 车辆完整数据 */
  vehicle: VehicleGPS;
  /** 触发原因 */
  reason: string;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================

/** 跟踪会话 DTO */
export interface TrackingSession {
  /** 会话 ID */
  sessionId: string;
  /** 车辆 ID */
  vehicleId: BusinessId;
  /** 关联警情 ID（可选） */
  alarmId?: BusinessId;
  /** 联动摄像头 ID 列表 */
  cameraIds: string[];
  /** 启动时间 */
  startedAt: ISOTimestamp;
}

/** 跟踪变更事件载荷 */
export interface TrackingChangedPayload {
  sessionId: string;
  /** 跟踪会话完整数据 */
  session: TrackingSession;
  /** 触发原因 */
  reason: string;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================

/** 值守视图 DTO */
export interface DutyView {
  /** 所属指挥中心 ID */
  centerId: string;
  /** 视野 */
  view: View;
  /** 加载图层 ID 列表 */
  layerIds: string[];
  /** 接警员 ID */
  operatorId: string;
  /** 启动时间 */
  startedAt: ISOTimestamp;
}

/** 值守变更事件载荷 */
export interface DutyChangedPayload {
  operatorId: string;
  /** 值守视图完整数据 */
  view: DutyView;
  /** 触发原因 */
  reason: string;
}

// =====================================================================
// 4. 通用控制层输入 DTO (Generic Control Input DTOs)
// =====================================================================

/** 视野定位指令 */
export interface LocateInput {
  /** 指令类型 */
  type: 'LocateInput';
  /** 目标位置（WGS84） */
  target: GeoPoint;
  /** 缩放级别 */
  zoom: ZoomLevel;
  /** 留边比例（0~1） */
  padding?: Ratio;
  /** 是否动画 */
  animate?: boolean;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 视野自适应指令 */
export interface FitInput {
  /** 指令类型 */
  type: 'FitInput';
  /** 目标包围盒（WGS84） */
  bbox: BoundingBox;
  /** 留边比例（10%~15%，强制 0.1~0.15） */
  padding: Ratio;
  /** 是否动画 */
  animate?: boolean;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 镜头跟随指令 */
export interface FollowInput {
  /** 指令类型 */
  type: 'FollowInput';
  /** 被跟随的目标 ID */
  targetId: BusinessId;
  /** 目标类型 */
  targetType: 'vehicle' | 'alarm' | 'call';
  /** 缩放级别 */
  zoom: ZoomLevel;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 几何图形绘制指令 */
export interface DrawGeometryInput {
  /** 指令类型 */
  type: 'DrawGeometryInput';
  /** 几何 ID（必填，加业务前缀） */
  geometryId: BusinessId;
  /** 几何类型 */
  geometryType: 'point' | 'polyline' | 'polygon' | 'circle';
  /** 几何数据（WGS84） */
  geometry: GeoPoint | GeoPoint[] | GeoPath;
  /** 样式 */
  style: GeometryStyle;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 几何样式 */
export interface GeometryStyle {
  strokeColor?: string;
  strokeWidth?: number;
  fillColor?: string;
  opacity?: Ratio;
  lineDash?: number[];
  zIndex?: number;
}

/** 运动学更新指令 */
export interface UpdateKinematicsInput {
  /** 指令类型 */
  type: 'UpdateKinematicsInput';
  /** 目标 ID */
  targetId: BusinessId;
  /** 新位置（WGS84） */
  position: GeoPoint;
  /** 速度（米/秒） */
  speed?: number;
  /** 航向角（弧度） */
  heading?: Radians;
  /** 时间戳 */
  timestamp: ISOTimestamp;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 空间查询指令 */
export interface SpatialQueryInput {
  /** 指令类型 */
  type: 'SpatialQueryInput';
  /** 查询类型 */
  queryType: 'within' | 'intersects' | 'nearby';
  /** 查询源（中心点或几何） */
  source: GeoPoint | GeoPath;
  /** 查询半径（米，仅 nearby 用） */
  radius?: Meters;
  /** 图层编码（例：gis:fire_vehicle） */
  layerCode?: string;
  /** 触发方 */
  source: ControlLayerSource;
}

/** 通用控制指令联合类型 */
export type GenericControlInput =
  | LocateInput
  | FitInput
  | FollowInput
  | DrawGeometryInput
  | UpdateKinematicsInput
  | SpatialQueryInput;

// =====================================================================
// 5. 通用控制层输出 DTO (Generic Ctrl Output)
// =====================================================================

/** 视野 DTO */
export interface View {
  /** 中心点（WGS84） */
  center: GeoPoint;
  /** 缩放级别 */
  zoom: ZoomLevel;
  /** 旋转角（弧度） */
  rotation?: Radians;
  /** 留边（0~1） */
  padding?: Ratio;
}

/** 围栏 DTO */
export interface Fence {
  /** 围栏 ID */
  fenceId: string;
  /** 圆心（WGS84） */
  center: GeoPoint;
  /** 半径（米） */
  radius: Meters;
  /** 围栏级别 */
  level: 'L1' | 'L2' | 'L3' | 'L4';
  /** 颜色 */
  color: string;
  /** 线型 */
  style: 'dashed' | 'solid';
}

/** 资源图层 DTO */
export interface ResourceLayer {
  /** 图层 ID */
  layerId: string;
  /** 图层编码（例：gis:env_build_aoi / gis:env_entrance_exit / gis:env_fire_water / gis:env_greatchina_road / gis:fire_vehicle） */
  layerCode: string;
  /** 最小缩放 */
  minZoom?: ZoomLevel;
  /** 最大缩放 */
  maxZoom?: ZoomLevel;
  /** 是否可见 */
  visible: boolean;
}

// =====================================================================
// 6. 焦点与互斥 (Focus & Mutual Exclusion)
// =====================================================================

/** 焦点拥有者 */
export type FocusOwner =
  | 'DutyCtrl'        // 值守（最低优先级）
  | 'CallCtrl'        // 来电
  | 'InquiryCtrl'     // 问询
  | 'TrackingCtrl'    // 跟踪
  | 'DispatchCtrl';   // 调派（最高优先级）

/** 焦点变更事件载荷 */
export interface FocusChangedPayload {
  /** 变更前焦点拥有者 */
  previousOwner?: FocusOwner;
  /** 变更后焦点拥有者 */
  currentOwner: FocusOwner;
  /** 触发原因 */
  reason: string;
  /** 时间戳 */
  timestamp: ISOTimestamp;
}

/** 焦点冲突事件载荷 */
export interface FocusConflictPayload {
  /** 冲突的焦点拥有者列表 */
  contenders: FocusOwner[];
  /** 裁决结果 */
  winner: FocusOwner;
  /** 触发原因 */
  reason: string;
  /** 时间戳 */
  timestamp: ISOTimestamp;
}

// =====================================================================
// 7. 状态机事件 (State Machine Event)
// =====================================================================

/** 状态机迁移事件 */
export interface StateMachineEventPayload {
  /** 状态机类型 */
  machine: 'AlarmStateMachine' | 'VehicleStateMachine' | 'DispatchStateMachine';
  /** 业务实体 ID */
  entityId: BusinessId;
  /** 变更前状态 */
  fromState: string;
  /** 变更后状态 */
  toState: string;
  /** 触发事件 */
  trigger: string;
  /** 时间戳 */
  timestamp: ISOTimestamp;
  /** 操作人 ID */
  operatorId: string;
}

// =====================================================================
// 8. 异常事件 (Exception Event)
// =====================================================================

/** 异常类型 */
export type ExceptionType =
  | 'COORD_VIOLATION'              // 坐标系污染
  | 'ILLEGAL_TRANSITION'           // 非法状态迁移
  | 'ROUTE_FALLBACK'               // 算路降级
  | 'GPS_LOST'                     // GPS 丢失
  | 'FOCUS_CONFLICT'               // 焦点冲突
  | 'ID_PREFIX_MISSING'            // ID 缺失前缀
  | 'PADDING_AUTO_FIX'             // Auto-Fit 留边自动修正
  | 'VIEW_OUT_OF_BOUNDS'           // 视野越界
  | 'FENCE_OUT_OF_RANGE'           // 围栏越界
  | 'WORKER_DEGRADED'              // Web Worker 降级
  | 'TRACKING_OVER_LIMIT'          // 跟踪车辆超限
  | 'CALL_QUEUE_OVERFLOW'          // 弹屏排队超限
  | 'PROTO_DESERIALIZE_FAIL'       // 协议反序列化失败
  | 'RESOURCE_LEAK'                // 资源回收失败
  | 'PERMISSION_DENIED';           // 权限不足

/** 异常严重级别 */
export type Severity = 'P0' | 'P1' | 'P2' | 'P3';

/** 异常事件载荷 */
export interface ExceptionEventPayload {
  /** 异常类型 */
  type: ExceptionType;
  /** 严重级别 */
  severity: Severity;
  /** 异常消息 */
  message: string;
  /** 异常上下文 */
  context: Record<string, unknown>;
  /** 时间戳 */
  timestamp: ISOTimestamp;
  /** 触发源 */
  source: ControlLayerSource;
}

// =====================================================================
// 9. 操作记录 (Operation Log)
// =====================================================================

/** 操作记录 DTO */
export interface OperationLog {
  /** 记录 ID */
  recordId: string;
  /** 操作类型 */
  operationType: string;
  /** 操作人 ID */
  operatorId: string;
  /** 操作原因 */
  reason?: string;
  /** 操作结果 */
  result: 'SUCCESS' | 'FAILURE' | 'EXCEPTION';
  /** 操作时间 */
  operationAt: ISOTimestamp;
  /** 业务上下文（警情 ID、车辆 ID 等） */
  context: Record<string, unknown>;
}

// =====================================================================
// 10. 协议版本演进规则 (Version Evolution)
// =====================================================================

/**
 * 历史概念模型的版本演进目标（不表示当前 transport 已实现版本协商）：
 * 1. 任何新增字段必须升级 minor 版本（v1.0 → v1.1）
 * 2. 任何删除字段必须升级 major 版本（v1.x → v2.0）
 * 3. 任何修改字段语义必须升级 major 版本
 * 4. 向后兼容策略：旧版本字段在 major 升级后保留 6 个月
 * 5. 历史版本号通过 HistoricalBusinessConceptEnvelope.version 携带；当前 transport 用 v
 *
 * v1.0 (2026-07-24): 初版发布
 *   - 业务控制层输出：Alarm/Call/Inquiry/Dispatch/Duty/Tracking
 *   - 通用控制层输入：Locate/Fit/Follow/DrawGeometry/UpdateKinematics/SpatialQuery
 *   - 通用控制层输出：View/Fence/ResourceLayer
 *   - 状态机事件 + 异常事件 + 操作记录
 */

// =====================================================================
// 11. 不变量校验契约 (Invariant Validation Contract)
// =====================================================================

/**
 * 历史 protectInvariants() 设计目标；不表示当前所有入口已实现以下统一校验：
 * 1. 坐标系 WGS84: GeoPoint.lng ∈ [-180, 180] && GeoPoint.lat ∈ [-90, 90]
 * 2. 业务 ID 前缀: BusinessId 以 alarm_/call_/route_/plan_/vehicle_/trail_ 之一开头
 * 3. 状态机迁移: 在 08-业务状态机定义.md 的迁移表内
 * 4. 业务焦点互斥: 同时仅一个业务域拥有焦点
 * 5. 操作人权限: 满足 04-角色与权限矩阵.md 定义
 */
export interface InvariantValidationResult {
  /** 是否通过 */
  valid: boolean;
  /** 违反的不变量类型 */
  violation?: ExceptionType;
  /** 详细消息 */
  message?: string;
  /** 违反的字段路径 */
  fieldPath?: string;
}

// =====================================================================
// 12. 导出 (Exports)
// =====================================================================

export type {
  // Base
  ProtocolVersion,
  Longitude,
  Latitude,
  ISOTimestamp,
  BusinessId,
  ZoomLevel,
  Meters,
  Radians,
  Ratio,
  // Geo
  GeoPoint,
  GeoPath,
  BoundingBox,
  // Envelope
  HistoricalBusinessConceptEnvelope,
  MessageType,
  ControlLayerSource,
  // Business
  AlarmStatus,
  AlarmType,
  SeverityLevel,
  AlarmProfile,
  AlarmChangedPayload,
  CallLocation,
  InquiryPayload,
  CallChangedPayload,
  DispatchStatus,
  DispatchPlan,
  DispatchRoute,
  RouteId,
  DispatchChangedPayload,
  VehicleStatus,
  VehicleGPS,
  VehicleChangedPayload,
  TrackingSession,
  TrackingChangedPayload,
  DutyView,
  DutyChangedPayload,
  // Generic Input
  LocateInput,
  FitInput,
  FollowInput,
  DrawGeometryInput,
  GeometryStyle,
  UpdateKinematicsInput,
  SpatialQueryInput,
  GenericControlInput,
  // Generic Output
  View,
  Fence,
  ResourceLayer,
  // Focus
  FocusOwner,
  FocusChangedPayload,
  FocusConflictPayload,
  // State Machine
  StateMachineEventPayload,
  // Exception
  ExceptionType,
  Severity,
  ExceptionEventPayload,
  // Operation Log
  OperationLog,
  // Invariant
  InvariantValidationResult,
};

// =====================================================================
// 13. Schema 校验辅助 (Validation Helpers)
// =====================================================================

/**
 * 校验 GeoPoint 是否合法 WGS84
 * @returns true 合法
 */
export function isValidGeoPoint(point: GeoPoint): boolean {
  return (
    typeof point.lng === 'number' &&
    typeof point.lat === 'number' &&
    point.lng >= -180 &&
    point.lng <= 180 &&
    point.lat >= -90 &&
    point.lat <= 90
  );
}

/**
 * 校验 BusinessId 是否含业务前缀
 * @returns true 合法
 */
export function isValidBusinessId(id: string): boolean {
  return /^(alarm_|call_|route_|plan_|vehicle_|trail_)/.test(id);
}

/**
 * 校验 Auto-Fit Padding 是否在 10%~15% 范围内
 * @returns true 合法
 */
export function isValidPadding(padding: Ratio): boolean {
  return padding >= 0.1 && padding <= 0.15;
}

