# 本地环境变量覆盖（个人配置，不入库）
# 用法：cp .env.local.example .env.local，按需修改
# 注意：.env.local 已在 .gitignore 中；本模板入库仅作字段说明。

# === 后端网关 ===
VITE_API_BASE_URL=/api

# === 消息网关 ===
# 清空后恢复从登录态动态拼接 WS 地址
VITE_DISPATCH_MOCK=true
# === WS 门控：二选一（模板默认 dev 远端；配 pnpm dev:local:test 本地联调时切 A 并注释 B）===
# A 本地测试服务（mock-ws :18080，含 /test-ui/ 一键测试台）
#VITE_WS_URL=ws://127.0.0.1:18080/message-client/ws
# B dev 远端（默认启用；注释上面那行并启用本行）
VITE_WS_URL=ws://ids-dev.ks.telewave.tech/message-client/ws
VITE_MESSAGE_SERVICE_ORIGIN=https://ids-dev.ks.telewave.tech
VITE_MESSAGE_CLIENT=ids-seat-web
VITE_MESSAGE_SEAT_KEY=8001
VITE_USE_WS=true
VITE_USE_POSTMESSAGE=false
VITE_USE_BROADCAST_CHANNEL=true
VITE_RELAY_CHANNEL_NAME=ids-map-screen-relay

# === 地图服务 ===
VITE_GEOSERVER_URL=http://<你的内网 GeoServer>:8080/geoserver/
VITE_GEOSERVER_WMS_URL=  # 模板独有：WMS 服务专用地址，正式环境不需要配置

# === 地图代理 ===
VITE_MAP_PROXY_API=http://<你的内网地图代理>

# === 路由服务 ===
VITE_ROUTE_API_URL=http://<你的内网路由服务>/api/routes

# === 其他 ===
VITE_USE_MOCK=true
VITE_ENABLE_DYNAMIC_ROUTES=false
VITE_USE_ONLINE_ICON=true
VITE_PERSIST_SECRET_KEY=
VITE_PANEL_25D_URL=
VITE_PANEL_3D_URL=

# 地图初始中心点（WGS84，格式固定 "[经度, 纬度]"；留空兜底深圳）
# 北京 [116.4074, 39.9042] / 深圳 [113.9354071, 22.54831]
VITE_MAP_CENTER=

# 高德行政区划配置（城市名 + adcode，用于地图服务定位）
VITE_MAP_ADMCODE=440300  # 深圳
# VITE_MAP_CITY=深圳市

# 地图搜索关键词（预留扩展，原 data.json keywords 字段已无业务引用）
# VITE_MAP_KEYWORDS=

# 天气数据源：new（主实例 /api/weather）| amap（旧高德代理）
VITE_WEATHER_SOURCE=new

# === 日志级别（新增：debug | info | warn | error；留空则 dev=debug、prod=warn）===
VITE_LOG_LEVEL=

# === 路径规划路段衔接门控 ===
# VITE_ROUTE_CONTINUITY_ENABLED=false  # 默认关闭，由后端兜底