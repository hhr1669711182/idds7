# 本地环境变量覆盖（个人配置，不入库）
# 用法：cp .env.local.example .env.local，按需修改
# 注意：.env.local 已在 .gitignore 中；本模板入库仅作字段说明。

# === 后端网关 ===
VITE_API_BASE_URL=/

# === 消息网关 ===
# 清空后恢复从登录态动态拼接 WS 地址
VITE_DISPATCH_MOCK=true
VITE_WS_URL=ws://ids-dev.ks.telewave.tech/message-client/ws
VITE_MESSAGE_SERVICE_ORIGIN=https://ids-dev.ks.telewave.tech
VITE_MESSAGE_CLIENT=ids-seat-web
VITE_MESSAGE_SEAT_KEY=8001
VITE_USE_WS=true
VITE_USE_POSTMESSAGE=false
VITE_USE_BROADCAST_CHANNEL=false
VITE_BROADCAST_CHANNEL_NAME=ids-gis-web

# === 地图服务 ===
VITE_GEOSERVER_URL=http://<你的内网 GeoServer>:8080/geoserver/
VITE_GEOSERVER_WMS_URL=

# === 高德代理 ===
VITE_AMAP_PROXY_API=http://<你的内网高德代理>

# === 路由服务 ===
VITE_ROUTE_API_URL=http://<你的内网路由服务>/api/routes

# === 其他 ===
VITE_USE_MOCK=true
VITE_ENABLE_DYNAMIC_ROUTES=false
VITE_USE_ONLINE_ICON=true
VITE_PERSIST_SECRET_KEY=
VITE_PANEL_25D_URL=
VITE_PANEL_3D_URL=

# 地图初始中心点（WGS84，格式固定 "[经度, 纬度]"；留空兜底深圳）
# 北京 [116.4074, 39.9042] / 深圳 [113.9354071, 22.54831]
VITE_MAP_CENTER=

# === 日志级别（新增：debug | info | warn | error；留空则 dev=debug、prod=warn）===
VITE_LOG_LEVEL=