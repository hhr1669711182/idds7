
# Vite env (custom file). Variables with VITE_ prefix are exposed to the client.
VITE_APP_ENV=production

VITE_API_BASE_URL=/

#远端服务器订阅设置
# 登录后由代码替换用户和会话占位符。
VITE_WS_URL=wss://ids-dev.ks.telewave.tech/message-client/ws
VITE_MESSAGE_SERVICE_ORIGIN=https://ids-dev.ks.telewave.tech
VITE_MESSAGE_CLIENT=ids-seat-web
VITE_MESSAGE_SEAT_KEY=8001
# VITE_WS_URL=ws://192.168.173.94:8000/ws/live
# VITE_WS_URL=ws://192.168.173.79:8787/

VITE_ROUTE_API_URL=http://192.168.173.94:8787/api/routes

VITE_GEOSERVER_URL=http://192.168.173.198:8080/geoserver/

VITE_AMAP_PROXY_API=http://ids-address-query-client/


VITE_PERSIST_SECRET_KEY=

VITE_ENABLE_DYNAMIC_ROUTES=false

VITE_USE_WS=true
VITE_USE_POSTMESSAGE=false

# Icon system
VITE_USE_ONLINE_ICON=true

# Mock
VITE_USE_MOCK=false


# Panels (iframe)
