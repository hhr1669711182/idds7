# Vite env (custom file). Variables with VITE_ prefix are exposed to the client.
VITE_APP_ENV=production

VITE_API_BASE_URL=/

#远端服务器订阅设置
# 登录后由代码替换用户和会话占位符。
VITE_WS_URL=wss://ids-dev.ks.telewave.tech/message-client/ws/ids-seat-web/{userId}/{sessionState}
VITE_MESSAGE_SERVICE_ORIGIN=https://ids-dev.ks.telewave.tech
VITE_MESSAGE_CLIENT=ids-seat-web
VITE_MESSAGE_SEAT_KEY=8001
# VITE_WS_URL=ws://192.168.173.94:8000/ws/live
# VITE_WS_URL=ws://192.168.173.79:8787/

VITE_ROUTE_API_URL=http://192.168.173.94:8787/api/routes

VITE_GEOSERVER_URL=http://192.168.173.198:8080/geoserver/

VITE_MAP_PROXY_API=http://ids-address-query-client/


VITE_PERSIST_SECRET_KEY=

VITE_ENABLE_DYNAMIC_ROUTES=false

VITE_USE_WS=true
VITE_USE_POSTMESSAGE=true

# Icon system
VITE_USE_ONLINE_ICON=true

# Mock
VITE_USE_MOCK=false


# Panels (iframe)
VITE_PANEL_25D_URL=
VITE_PANEL_3D_URL=

# BroadcastChannel（同源多标签页广播）
VITE_USE_BROADCAST_CHANNEL=true
VITE_RELAY_CHANNEL_NAME=ids-map-screen-relay

# 地图初始中心点（WGS84 [经度, 纬度]）：贵阳（贵州省）
VITE_MAP_CENTER=[106.630, 26.6477]

# 高德行政区划配置（production=贵阳）
VITE_MAP_ADMCODE=520100
VITE_MAP_CITY=贵阳市

# 路径规划路段衔接门控：默认关闭，仅兜底使用后端已有计算
VITE_ROUTE_CONTINUITY_ENABLED=false
