<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 核心：添加缺失的 MIME 类型 -->
    <staticContent>
      <!-- JSON 文件 -->
      <mimeMap fileExtension=".geojson" mimeType="application/json" />
    </staticContent>

    <!-- 静态与动态压缩：对 JS/CSS/JSON/GeoJSON 生效，显著降低首屏传输体积 -->
    <httpCompression>
      <!-- 动态请求压缩（ASP.NET 响应） -->
      <dynamicCompressionEnabled>true</dynamicCompressionEnabled>
      <dynamicCompressionLevel>9</dynamicCompressionLevel>
      <!-- 静态文件压缩（JS/CSS/SVG 等，需安装 IIS 静态内容压缩模块） -->
      <staticCompressionEnabled>true</staticCompressionEnabled>
      <staticCompressionLevel>9</staticCompressionLevel>
    </httpCompression>
  </system.webServer>
</configuration>