
# Vite env (custom file). Variables with VITE_ prefix are exposed to the client.
VITE_APP_ENV=development

VITE_API_BASE_URL=/


#远端服务器订阅设置
# 测试页面联调专用；清空后恢复从登录态动态拼接 WS 地址。
# 本地车辆与消息联调；恢复真实服务时关闭 VITE_DISPATCH_MOCK 并恢复下方远端 WS。
VITE_DISPATCH_MOCK=true
# VITE_WS_URL=ws://localhost:18080/message-client/ws/ids-seat-web/alarm-debug-user/alarm-debug-session
VITE_WS_URL=ws://ids-dev.ks.telewave.tech/message-client/ws
# VITE_MESSAGE_SERVICE_ORIGIN=http://localhost:18080
VITE_MESSAGE_SERVICE_ORIGIN=https://ids-dev.ks.telewave.tech #远端地址
VITE_MESSAGE_CLIENT=ids-seat-web
VITE_MESSAGE_SEAT_KEY=8001
VITE_USE_WS=true
# VITE_WS_URL=ws://192.168.173.94:8000/ws/live
# VITE_WS_URL=ws://192.168.173.198:15674/ws

VITE_ROUTE_API_URL=http://192.168.173.94:8787/api/routes
# 173.198 地图服务地址 169.58(北京)
VITE_GEOSERVER_URL=http://192.168.173.198:8080/geoserver/

VITE_AMAP_PROXY_API=http://192.168.169.28:33082

VITE_PERSIST_SECRET_KEY=

VITE_ENABLE_DYNAMIC_ROUTES=false

VITE_USE_WS=true
VITE_USE_POSTMESSAGE=false

# Icon system
VITE_USE_ONLINE_ICON=true

# Mock
VITE_USE_MOCK=true
MOCK_WS_PORT=
MOCK_WS_HOST=
MOCK_WS_PUSH_INTERVAL_MS=

# Panels (iframe)
VITE_PANEL_25D_URL=
VITE_PANEL_3D_URL=
